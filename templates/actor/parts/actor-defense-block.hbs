{{!-- Defense Block --}}
<div class="defense-name">
    {{#if def.defenseModifiers}}
        <span class="toggle control" data-toggle-id="{{def.name}}-defense-modifier-toggle">
            <a>
                <i class="fas {{#if (lookup toggles (concat def.name "-defense-modifier-toggle"))}}fa-minus{{else}}fa-plus{{/if}}"></i>
            </a>
        </span>
    {{/if}}
    {{toTitleCase def.name}}
</div>
{{!-- Only Reflex, Fortitude and Will carry an overrideKey (system.overrides.ref/fort/will);
      the modifier sub-rows have no override store, so they get no right-click menu. --}}
<div class="{{#if def.overrideKey}}numeric-override{{/if}}" data-override="{{def.override}}" data-override-name="{{def.name}}"
     data-override-key="{{def.overrideKey}}">
    <input class="defense-total" type="text" value="{{def.total}}"
           placeholder="" name="system.attributes.{{id}}.manual" disabled/>
</div>
<input type="text" value="10" placeholder="" disabled/>
<input type="text" value="{{def.armorBonus}}" placeholder="" disabled/>
<input type="text" value="{{def.abilityBonus}}" placeholder="" disabled/>

{{!-- Assigned Defense points. Only the three real Defenses have a pool; the
      recursive modifier sub-rows fall through to a read-only blank. --}}
{{#if pool}}
    <input class="defense-assign" type="number" name="system.defense.defensePoints.{{poolKey}}.level1"
           value="{{pool.level1}}" min="0" max="{{budget.perDefenseMax}}" data-dtype="Number"
           title="Assigned Defense points (max {{budget.perDefenseMax}})"/>
    <input class="defense-assign{{#unless budget.level10Unlocked}} locked{{/unless}}" type="number"
           name="system.defense.defensePoints.{{poolKey}}.level10"
           value="{{pool.level10}}" min="0" max="{{budget.perDefenseMax}}" data-dtype="Number"
           {{#unless budget.level10Unlocked}}disabled{{/unless}}
           title="{{#if budget.level10Unlocked}}Level 10 Defense points (max {{budget.perDefenseMax}}){{else}}Unlocks at level 10{{/if}}"/>
{{else}}
    <input type="text" value="" placeholder="" disabled/>
    <input type="text" value="" placeholder="" disabled/>
{{/if}}

<input type="text" value="{{def.miscBonus}}" placeholder="" title="{{def.miscBonusTip}}" disabled/>

{{#if def.defenseModifiers}}
    {{#if (lookup toggles (concat def.name "-defense-modifier-toggle"))}}
        {{#each def.defenseModifiers as |defenseModifier id|}}
            {{> 'systems/swse/templates/actor/parts/actor-defense-block.hbs' def=defenseModifier}}
        {{/each}}
    {{/if}}
{{/if}}
