<li class="skill-row draggable {{skill.rowColor}} collapsable{{#if depth}} depth-1{{/if}}" data-variable="{{skill.variable}}" data-label="{{skillId}}" data-type="skill">
    <span class="skill-toggle">
        {{#if skill.situationalSkills}}
            <span class="toggle control" data-toggle-id="{{@root.actor._id}}-{{skillId}}">
                <a>
                    <i class="fas {{#if
                            (lookup toggles (concat @root.actor._id "-" skillId))}}fa-minus{{else}}fa-plus{{/if}}"></i>
                </a>
            </span>
        {{/if}}
    </span>

    <span class="skill-roll">
        <a class="rollable" title="Roll 1d20 + {{skill.value}}"
           data-label="{{skillId}}" data-roll="1d20 + {{skill.value}}"
           data-notes="{{skill.notes}}" data-key="@{{skillId}}">
            <i class="fas fa-dice-d20"></i>
        </a>
    </span>

    <span class="skill-name" title="{{skill.label}}"><a href="{{skill.link}}">{{skill.label}}</a></span>

    <span class="skill-total" title="{{skill.title}}">{{skill.value}}</span>

    <span class="skill-ability">{{toUpperCase skill.attribute}} ({{skill.abilityBonus}})</span>

{{#unless disableTrained}}
    <span class="skill-trained">
        <label title="trained skills get an additional +5">
            <input class="skill direct"
                   type="checkbox"
                   data-id="{{skillId}}"
                   data-name="system.skills.{{skillId}}.trained"
                   name="system.skills.{{skillId}}.trained"
                {{#if skill.trained}}checked{{/if}} {{#if skill.locked}}disabled{{/if}}/>
        </label>
    </span>
{{/unless}}
{{#unless disableBonus}}
    <span class="skill-bonus">
        <input class="input" name="system.skills.{{skillId}}.manualBonus" type="number"
               value="{{skill.manualBonus}}" placeholder="0"/>
    </span>
{{/unless}}
</li>
{{#if skill.situationalSkills}}
    {{#if (lookup toggles (concat @root.actor._id "-" skillId))}}
        {{#each skill.situationalSkills as |skill id|}}
            {{#unless skill.hide}}
                {{> 'systems/swse/templates/actor/parts/skills/skill-row.hbs' skill=skill skillId=skill.sitKey toggles=../actor.system.toggles disableTrained=../disableTrained disableBonus=../disableBonus depth=(sum 1 ../depth)}}
            {{/unless}}
        {{/each}}
    {{/if}}
{{/if}}
