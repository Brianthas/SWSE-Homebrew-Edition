{{!-- Health Block --}}
<div class="health-block panel area-health">
    <h1 class="top-label resource-label">Hit Points</h1>

    <div class="hp-headline">
        <div class="field">
            <label for="currentHealth">Current</label>
            <input id="currentHealth" type="number" name="system.health.value"
                   value="{{actor.health.value}}" data-dtype="Number"/>
        </div>
        <span class="hp-divider">/</span>
        <div class="field">
            <label for="maxHealth" title="Set on the Classes tab, from class levels plus any override.">Total</label>
            <input id="maxHealth" type="text" value="{{actor.health.max}}" placeholder="" disabled/>
        </div>
    </div>

    <div class="field field-center-label">
        <label for="maneuverDefense" title="Total Fortitude Defense + 5">Maneuver Defense</label>
        <input id="maneuverDefense" type="text" value="{{actor.maneuverDefense}}" placeholder="" disabled/>
    </div>

    <div class="stat-grid">
        <div class="field">
            <label for="damageReduction">Dmg Reduction</label>
            {{!-- Blank falls back to the armor/talent-derived value shown as placeholder. --}}
            <input id="damageReduction" type="text" name="system.defense.damageReductionOverride"
                   value="{{actor.system.defense.damageReductionOverride}}"
                   placeholder="{{actor.system.defense.derivedDamageReduction}}"
                   data-dtype="String"
                   title="Leave blank to use the value from armor and talents. Accepts notation like 5/lightsabers"/>
        </div>
    {{#unless disableSimpleSpeedAndBaseAttackBonus}}
        <div class="field field-roll">
            <label for="baseAttack">Base Attack</label>
            <input id="baseAttack" type="text" value="{{actor.baseAttackBonus}}" placeholder="" disabled/>
            <input type="checkbox" class="roll-bonus-toggle" data-action="toggle-roll-bonus-prompt" data-name="system.toggles.baseAttackBonusPrompt" title="Prompt for an additional bonus before rolling" {{#if actor.system.toggles.baseAttackBonusPrompt}}checked{{/if}}/>
            <a class="roll-badge" data-action="roll-with-bonus-toggle" title="Roll 1d20 + {{actor.baseAttackBonus}} (Ctrl-click for Advantage, Alt-click for Disadvantage)" data-label="Base Attack Bonus" data-formula="1d20 + {{actor.baseAttackBonus}}"><i class="fas fa-dice-d20"></i></a>
        </div>
    {{/unless}}
        <div class="field field-roll">
            <label for="grapple">Grapple</label>
            <input id="grapple" type="text" value="{{actor.grapple}}" placeholder="" disabled/>
            <input type="checkbox" class="roll-bonus-toggle" data-action="toggle-roll-bonus-prompt" data-name="system.toggles.grapplePrompt" title="Prompt for an additional bonus before rolling" {{#if actor.system.toggles.grapplePrompt}}checked{{/if}}/>
            <a class="roll-badge" data-action="roll-with-bonus-toggle" title="Roll 1d20 + {{actor.grapple}} (Ctrl-click for Advantage, Alt-click for Disadvantage)" data-label="Grapple" data-formula="1d20 + {{actor.grapple}}"><i class="fas fa-dice-d20"></i></a>
        </div>
    </div>

{{#unless disableSimpleSpeedAndBaseAttackBonus}}
    <div class="stat-grid">
        <div class="field">
            <label for="characterSpeed">Speed</label>
            <input id="characterSpeed" type="text" title="{{actor.speed}}" value="{{actor.speed}}" placeholder="" disabled/>
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <button type="button" class="first-aid-button" data-action="first-aid"
                    title="Roll your Healing Hit Die + Con modifier + character level, plus any bonus you enter, and add it to current HP (capped at max).">
                <i class="fas fa-kit-medical"></i> First Aid
            </button>
        </div>
    </div>
{{/unless}}

{{#unless disableSecondWind}}
    <div class="field">
        <label for="secondWind" title="Regardless of second winds per day, only one can be used per encounter.">Second Winds/Day</label>
        <div class="toggle-track">
            {{#times actor.secondWind.perDay}}
                <input data-action="toggle-second-wind" title="Spent" type="checkbox" data-name="system.toggles.secondWinds.{{this}}"
                       {{#if (lookup ../actor.system.toggles.secondWinds this)}}checked{{/if}}>
            {{else}}
                <span class="toggle-empty">None</span>
            {{/times}}
        </div>
    </div>
{{/unless}}

{{!-- First Aid is no longer tracked here: homebrew makes it a per-injury resource
      rather than a per-day one, so there's nothing daily to count. --}}

    {{#ifEquals actor.type "vehicle"}}
    <h1 class="top-label resource-label">Shields</h1>
    <div class="stat-grid cols-2">
        <div class="field numeric-override" data-override="{{actor.shields.override}}" data-override-name="Total Shields" data-override-key="system.shields.override">
            <label for="maxShields">Total</label>
            <input id="maxShields" type="text" value="{{actor.shields.max}}" placeholder="" disabled/>
        </div>
        {{#if actor.shields.failureChance}}
            <div class="field">
                <label for="failureChance">Failure Chance</label>
                <input id="failureChance" type="text" value="{{actor.defense.fort.total}}" placeholder="" disabled/>
            </div>
        {{/if}}
        <div class="field">
            <label for="currentShield">Current</label>
            <input id="currentShield" type="number" name="system.shields.value" value="{{actor.shields.value}}" data-dtype="Number"/>

            <div class="control-2" title="Toggle Shield {{#if actor.shields.active}}Off{{else}}On{{/if}}"><a data-action="shield" data-action-type="toggle" class="{{#if actor.shields.active}}cursor{{/if}}"><i class="fas fa-shield-virus"></i></a></div>
            <div class="control-1" title="Shield +5"><a data-action="shield" data-action-type="plus"><i class="fas fa-plus"></i></a></div>
            <div class="control-0" title="Shield -5"><a data-action="shield" data-action-type="minus"><i class="fas fa-minus"></i></a></div>
        </div>
    </div>
    {{/ifEquals}}
</div>
