{{#if attack}}
    {{#unless attack.hide}}
        <div class="attack attack-card {{#if attack.provider}}vehicle{{/if}} collapsible-container" data-attack-key="{{attack.attackKey}}" data-type="attack"
             data-label="{{attack.name}}" data-img="{{attack.img}}">
            <div class="attack-row">
                <span class="attack-toggle">
                    <span class="toggle control" data-toggle-id="{{concat "attack-" id}}">
                        <a><i class="fas {{#if
                                (lookup toggles (concat "attack-" id))}}fa-minus{{else}}fa-plus{{/if}}"></i></a>
                    </span>
                </span>
                <span class="attack-image"><img src="{{attack.img}}" alt=""/></span>
                {{#if attack.item.id}}
                    <a class="attack-name" data-action="view" data-item-id="{{attack.item.id}}" title="{{attack.name}}">{{attack.name}}</a>
                {{else}}
                    {{#if attack.isCustomAttack}}
                        <a class="attack-name" data-action="edit-custom-attack" data-attack-key="{{attack.attackKey}}" title="{{attack.name}} (click to edit)">{{attack.name}}</a>
                    {{else}}
                        <span class="attack-name" title="{{attack.name}}">{{attack.name}}</span>
                    {{/if}}
                {{/if}}

                {{#if attack.abilityOverrideOptions.length}}
                    <select class="attack-ability-select" data-action="ability-override" data-item-id="{{attack.item.id}}"
                            title="Ability used for the attack roll">
                        {{#each attack.abilityOverrideOptions as |opt|}}
                            <option value="{{opt.value}}" {{#ifEquals opt.value ../attack.item.system.abilityOverride}}selected{{/ifEquals}}>{{opt.label}}</option>
                        {{/each}}
                    </select>
                    {{!-- Damage normally follows the attack ability; this only needs setting for
                          the cases that differ (e.g. a turret: Dexterity to hit, Intelligence to damage). --}}
                    <select class="attack-ability-select attack-damage-ability-select" data-action="damage-ability-override" data-item-id="{{attack.item.id}}"
                            title="Ability used for the damage roll (defaults to the attack ability)">
                        {{#each attack.damageAbilityOverrideOptions as |opt|}}
                            <option value="{{opt.value}}" {{#ifEquals opt.value ../attack.item.system.damageAbilityOverride}}selected{{/ifEquals}}>{{opt.label}}</option>
                        {{/each}}
                    </select>
                {{/if}}

                {{#if attack.handsOverrideOptions.length}}
                    <select class="attack-hands-select" data-action="hands-override" data-item-id="{{attack.item.id}}"
                            title="Wielded one- or two-handed">
                        {{#each attack.handsOverrideOptions as |opt|}}
                            <option value="{{opt.value}}" {{#ifEquals opt.value ../attack.item.system.handsOverride}}selected{{/ifEquals}}>{{opt.label}}</option>
                        {{/each}}
                    </select>
                {{/if}}

                <span class="attack-tohit" title="{{attack.attackRoll.formula}}">{{{attack.attackRoll.formattedFormula}}}</span>
                <span class="attack-damage" title="{{attack.damageRoll.formula}}">{{{attack.damageRoll.formattedFormula}}}</span>

                <a class="attack-roll-btn attack-button" data-action="singleAttack" data-attack-key="{{attack.attackKey}}" title="Attack — opens a dialog for bonuses/Advantage/Disadvantage (Ctrl-click or Alt-click to skip the dialog and roll immediately with Advantage/Disadvantage)">
                    <i class="fas fa-dice-d20"></i>
                </a>

                {{!-- The synthetic Unarmed Attack has no document behind it, so there's nothing to
                      rename; every other attack renames its item (or its custom-attack config). --}}
                {{#unless attack.isUnarmedAttackPlaceholder}}
                    <a class="attack-rename-btn" data-action="rename-attack" data-attack-key="{{attack.attackKey}}" title="Rename this attack">
                        <i class="fas fa-pen"></i>
                    </a>
                {{/unless}}

                {{#if attack.isCustomAttack}}
                    <a class="attack-delete-btn" data-action="delete-custom-attack" data-attack-key="{{attack.attackKey}}" title="Delete this custom attack">
                        <i class="fas fa-trash"></i>
                    </a>
                {{/if}}
            </div>

            <div class="collapsible attack-detail" style="display: {{#if
                    (lookup toggles (concat "attack-" id))}}flex{{else}}none{{/if}}">

                <div class="attack-detail-row">
                    <span class="detail-item"><span class="detail-label">Range</span><span class="detail-value">{{attack.rangeDisplay}}</span></span>
                    <span class="detail-item"><span class="detail-label">Crit.</span><span class="detail-value">{{attack.critical}}</span></span>
                    <span class="detail-item"><span class="detail-label">Type</span><span class="detail-value">{{attack.type}}</span></span>
                </div>

                <div class="attack-notes" title="{{{attack.notesText}}}">{{{attack.notesHTML}}}</div>

                <div class="flex flex-row flex-wrap">
                    {{#each attack.modes as |mode id|}}
                        <div class="mode-selector mode-group editor" data-type="{{mode.type}}"
                             data-mode-path="{{mode.modePath}}"
                             data-mode="{{mode.name}}" data-item-id="{{../../attack.weaponId}}"
                             data-group="{{mode.group}}" data-attributes="{{stringify mode.attributes}}">
                            <label>{{mode.name}}</label>
                            <input type="checkbox" {{#unless mode.disabled}}checked{{/unless}} data-type="disable"
                                   data-action="effect-control" data-effect-uuid="{{mode.uuid}}"/>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
    {{/unless}}
{{/if}}
