{{!-- Damage rolled on its own, with the attack resolved away from Foundry. Smaller than the attack
      card: there is no to-hit roll and no per-target verdict. Built from attack-card.mjs
      damageOnlyCardView. The roll is rendered here because Foundry only substitutes its own roll
      HTML when the content has no child elements. --}}
<div class="swse-card">
    <section class="swse-card-attack{{#if critical}} is-critical{{/if}}">
        <header class="swse-card-weapon">
            <img class="swse-card-weapon-img" src="{{img}}" alt="">
            <div class="swse-card-weapon-name">
                <span class="swse-card-title">{{name}}</span>
                <span class="swse-card-subtitle">Damage only</span>
            </div>
            {{#if critical}}<span class="swse-card-tag is-critical">Critical</span>{{/if}}
            {{#if damageType}}<span class="swse-damage-type type-{{damageTypeKey}}">{{damageType}}</span>{{/if}}
        </header>
        <div class="swse-card-band">
            {{> 'systems/swse/templates/roll/card-roll.hbs' label="Damage" view=damage}}
            {{#if targets.length}}
                <div class="swse-chips">{{#each targets as |target|}}<span class="swse-chip">{{target.name}}</span>{{/each}}</div>
            {{/if}}
        </div>
        <div class="swse-card-buttons">
            <button type="button" data-action="apply-attack" data-type="damage" data-attack-summary="{{attackSummaries}}" data-apply="{{apply}}"><i class="fas fa-explosion"></i><span>Damage</span></button>
            <button type="button" data-action="apply-attack" data-type="half" data-attack-summary="{{attackSummaries}}" data-apply="{{apply}}"><i class="fas fa-circle-half-stroke"></i><span>Half</span></button>
            <button type="button" data-action="apply-attack" data-type="double" data-attack-summary="{{attackSummaries}}" data-apply="{{apply}}"><i class="fas fa-angles-up"></i><span>Double</span></button>
            <button type="button" data-action="apply-attack" data-type="heal" data-attack-summary="{{attackSummaries}}" data-apply="{{apply}}"><i class="fas fa-hand-holding-heart"></i><span>Heal</span></button>
        </div>
        {{#if notesHTML}}<div class="swse-card-notes">{{{notesHTML}}}</div>{{/if}}
    </section>
</div>
