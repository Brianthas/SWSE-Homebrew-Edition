<div class="classes-header swse resource panel area-classes">
    <h1 class="top-label resource-label">
        Classes
        <span class="skills-counter" title="Character level">{{actor.levelSummary}}</span>
        <div class="classes-header-actions">
            <a data-action="compendium" data-type="Item" data-filter="-type:class" title="{{localize "Open Compendium"}}">
                <i class="fas fa-folder-plus"></i>
            </a>
        </div>
    </h1>

    <ul class="class-list">
        {{#each actor.classSummaries as |group|}}
            <li class="class-group item" data-item-id="{{group.id}}">
                <div class="class-row">
                    <span class="class-toggle">
                        <span class="toggle control" data-toggle-id="{{@root.actor._id}}-class-{{group.id}}">
                            <a><i class="fas {{#if (lookup @root.actor.system.toggles (concat @root.actor._id "-class-" group.id))}}fa-minus{{else}}fa-plus{{/if}}"></i></a>
                        </span>
                    </span>
                    <span class="class-image"><img src="{{group.img}}" alt="{{group.name}}"/></span>
                    <a class="class-name" data-action="view" data-item-id="{{group.id}}" title="View Class Description">{{group.name}}</a>
                    <span class="class-die" title="Hit die">{{group.levels.[0].levelUpHitPoints}}</span>
                    <span class="class-levels">Lv {{group.levelRangeLabel}}</span>
                    {{#unless @root.actor.isFollower}}
                        <span class="class-hp" title="Hit points from this class">{{group.totalHp}}</span>
                    {{/unless}}
                    <span class="class-controls">
                        {{#unless @root.actor.isFollower}}
                            <a class="item-control item-duplicate" title="Add a level of {{group.name}}"><i class="fas fa-plus"></i></a>
                        {{/unless}}
                        {{#if group.hasLatest}}
                            <a data-action="remove-class-level" title="Remove most recent level (Shift-click to skip the confirmation)"><i class="fas fa-trash"></i></a>
                        {{/if}}
                    </span>
                </div>

                {{#if (lookup @root.actor.system.toggles (concat @root.actor._id "-class-" group.id))}}
                    {{#unless @root.actor.isFollower}}
                        <div class="class-level-detail">
                            <div class="class-level-row class-level-row-header">
                                <span class="level-label"></span>
                                <span class="level-hp">HP</span>
                                <span class="level-con">Con</span>
                                <span class="level-total">Total</span>
                            </div>
                            {{#each group.levels as |lvl|}}
                                <div class="class-level-row">
                                    <span class="level-label">Lv {{lvl.characterLevel}}</span>
                                    {{#if lvl.canRerollHealth}}
                                        <span class="level-hp">
                                            <input type="number" class="level-hp-input" data-action="update-level-attribute"
                                                   data-context="health" data-item="{{group.id}}" data-attribute="rolledHp"
                                                   data-level="{{lvl.classLevel}}" value="{{lvl.classLevelHealth}}"/>
                                            <a class="rollable level-roll-btn" title="Roll {{lvl.levelUpHitPoints}}"
                                               data-context="health" data-item="{{group.id}}" data-item-attribute="rolledHp"
                                               data-level="{{lvl.classLevel}}" data-roll="{{lvl.levelUpHitPoints}}">
                                                <i class="fas fa-dice"></i>
                                            </a>
                                            <a class="rollable level-avg-btn" title="Take the average ({{lvl.averageHitPoints}})"
                                               data-context="health" data-item="{{group.id}}" data-item-attribute="rolledHp"
                                               data-level="{{lvl.classLevel}}" data-roll="{{lvl.averageHitPoints}}">Avg</a>
                                        </span>
                                    {{else}}
                                        <span class="level-hp level-hp-fixed" title="Starting hit points - fixed, not rolled">{{lvl.classLevelHealth}}</span>
                                    {{/if}}
                                    <span class="level-con">{{numberFormat @root.actor.system.abilities.con.mod sign=true}}</span>
                                    <span class="level-total">{{sum lvl.classLevelHealth @root.actor.system.abilities.con.mod}}</span>
                                </div>
                            {{/each}}
                        </div>
                    {{/unless}}
                {{/if}}
            </li>
        {{/each}}
    </ul>

    {{#unless actor.isFollower}}
        <div class="class-summary-footer">
            <span class="label">Other Bonuses</span>
            <span class="value">{{numberFormat actor.health.bonusHP sign=true}}</span>
            {{#if actor.highestClassHitDie}}
                <span class="label" title="Multiclassing Hit Die for Healing is the highest Hit Die of all classes taken.">Healing Hit Die</span>
                <span class="value">{{actor.highestClassHitDie}}</span>
            {{/if}}
            <span class="label">Total HP</span>
            <input type="number" class="value hp-override" name="system.health.override"
                   placeholder="{{actor.health.derivedMax}}" value="{{actor.health.override}}"
                   title="Leave blank to use the sum from classes and bonuses above."/>
        </div>
    {{/unless}}
</div>

{{#if actor.poorlyFormattedClasses}}
    <div>{{actor.poorlyFormattedClasses}}</div>
{{/if}}
