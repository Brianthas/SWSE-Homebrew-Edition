<div class="condition-block panel area-condition">
    <h1 class="top-label resource-label">Condition</h1>

    {{#unlessEquals actor.type "vehicle"}}
    {{#unless actor.isFollower}}
    <div class="point-pools">
        <div class="point-pool" title="Force Points refresh daily">
            <span class="point-pool-label">Force Points</span>
            <div class="point-pool-values">
                <input id="forcePoints" type="number" name="system.forcePoints.quantity"
                       value="{{actor.forcePoints.quantity}}" data-dtype="Number"/>
                <span class="point-pool-divider">/</span>
                <input id="forcePointsMax" type="text" value="{{actor.forcePoints.max}}" title="Per day" disabled/>
            </div>
        </div>
        <div class="point-pool" title="Homebrew: a Destiny Point can be broken down into a Force Point — tracked here separately since it doesn't refresh daily like regular Force Points">
            <span class="point-pool-label">Bonus Force Points</span>
            <div class="point-pool-values single">
                <input id="bonusForcePoints" type="number" name="system.bonusForcePoints"
                       value="{{actor.system.bonusForcePoints}}" data-dtype="Number"/>
            </div>
        </div>
        <div class="point-pool" title="Running total — spent points are lost. Maximum equals Force Points per day.">
            <span class="point-pool-label">Destiny Points</span>
            <div class="point-pool-values">
                <input id="destinyPoints" type="number" name="system.destinyPoints"
                       value="{{actor.system.destinyPoints}}" data-dtype="Number"/>
                <span class="point-pool-divider">/</span>
                <input id="destinyPointsMax" type="text" value="{{actor.forcePointsPerDay}}" title="Equal to Force Points per day" disabled/>
            </div>
        </div>
    </div>

    <div class="field">
        <div class="darkside-heading">
            <span class="field-label">Dark Side Score: {{actor.system.darkside.finalScore}}
                / {{actor.system.darkside.max}}{{#ifGT actor.system.darkside.taint 0}} DST: {{actor.system.darkside.taint}}{{/ifGT}}</span>
            {{!-- Shown only once the score reaches (or passes) the maximum. --}}
            {{#ifGT actor.system.darkside.finalScore (math actor.system.darkside.max "-" 1)}}
                <span class="fallen-badge" title="Dark Side Score has reached its maximum">Fallen</span>
            {{/ifGT}}
        </div>
        <div class="darkside-track">
            {{#times (math actor.system.darkside.max "+" 1)}}
                <label>
                    {{this}}
                    {{!-- --pip-t is this pip's 0..1 position along the track; the CSS
                          interpolates white -> red across it. --}}
                    <input class="dark-side-button{{#ifGT ../actor.system.darkside.finalScore this}} lessthan{{/ifGT}}"
                           style="--pip-t: {{math this "/" ../actor.system.darkside.max}};"
                           type="radio" name="system.darkside.value"
                           {{#ifEquals ../actor.system.darkside.finalScore this}}checked{{/ifEquals}} value="{{math this "-" ../actor.system.darkside.taint}}">
                </label>
            {{/times}}
        </div>
    </div>
    {{/unless}}
    {{/unlessEquals}}
</div>
