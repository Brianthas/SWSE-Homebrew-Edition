<div class="item-pane">
    <div class="middle-right-sidebar">
            {{#ifEquals item.type "weapon"}}
                {{> 'systems/swse/templates/item/parts/stats/weapon.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "armor"}}
                {{> 'systems/swse/templates/item/parts/stats/armor.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "equipment"}}
                {{> 'systems/swse/templates/item/parts/stats/equipment.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "upgrade"}}
                {{> 'systems/swse/templates/item/parts/stats/upgrade.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "implant"}}
                {{> 'systems/swse/templates/item/parts/stats/implant.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "droid system"}}
                {{> 'systems/swse/templates/item/parts/stats/droid-system.hbs'}}
            {{/ifEquals}}
            {{#ifEquals item.type "vehicleSystem"}}
                {{> 'systems/swse/templates/item/parts/stats/vehicle-system.hbs'}}
            {{/ifEquals}}
            {{#if item.system}}
                {{editor item.system.description target="system.description" button=true owner=owner
                         editable=editable engine="prosemirror"}}
            {{else}}
                {{editor item._source.system.description target="system.description" button=true owner=owner
                         editable=editable engine="prosemirror"}}
            {{/if}}
            {{#each item.effects as |modification id|}}
                {{#if modification.flags.swse.itemModifier}}
                    <div class="panel collapsible-container">
                        <h3 class="collapse-toggle" data-action="collapse-toggle">{{modification.name}}</h3>
                        <div style="display: none" class="collapsible description">{{{modification.flags.swse.description}}}</div>
                    </div>
                {{/if}}
            {{/each}}
            {{> 'systems/swse/templates/item/parts/item-sections.hbs'}}
    </div>
</div>