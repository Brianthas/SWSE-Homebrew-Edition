<li class="directory-group" data-tree="{{treeName}}">
    <h3 class="group-header">
        <i class="fas {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
        <span class="group-name">{{treeName}}</span>
        <span class="group-count">({{count}})</span>
    </h3>
    <ul class="group-items" style="display: {{#if expanded}}block{{else}}none{{/if}}"></ul>
</li>
