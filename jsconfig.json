{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["fvtt-types"],

    "checkJs": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitAny": false,

    "maxNodeModuleJsDepth": 0
  },
  "include": ["module/**/*.mjs", "module_test/**/*.mjs", "scripts/**/*.mjs", "gulpfile.js"],
  "exclude": ["node_modules", "packs", "css", "icon"]
}
